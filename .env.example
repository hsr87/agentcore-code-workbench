AWS_REGION=us-east-1
# Custom Code Interpreter id (default: the managed aws.codeinterpreter.v1, which has no outbound network)
CWE_CODE_INTERPRETER_ID=aws.codeinterpreter.v1
CWE_SESSION_TIMEOUT_SECONDS=1800
# Recording and snapshot store: a local directory or s3://bucket/prefix
CWE_STORAGE_URI=.cwe_data
# Optional AgentCore Memory id. When set, message events are also written as Memory events.
CWE_MEMORY_ID=
# Models for the LLM judge and the agent
# Outside the US regions use a cross-region inference profile the region offers, e.g. global.anthropic.claude-opus-5 in Seoul.
CWE_JUDGE_MODEL=anthropic.claude-opus-5
CWE_AGENT_MODEL=us.anthropic.claude-opus-5
CWE_ENABLE_LLM_JUDGE=true
# Android device lab. EKS is the default backend; ./scripts/deploy.sh --stage images writes .env.eks.
CWE_PROJECT_NAME=cwe-eks
CWE_ANDROID_BACKEND=eks
CWE_EKS_NAMESPACE=cwe
CWE_EKS_CLUSTER_NAME=
CWE_OPERATOR_ROLE_ARN=
CWE_EKS_CONTEXT=
# port-forward: local kubectl tunnel (default) | pod: approved in-cluster orchestrator
CWE_EKS_ACCESS=port-forward
CWE_EKS_BUILDER_IMAGE=
# Kubeconfig written by `cwe eks-kubeconfig` when only CWE_EKS_CLUSTER_NAME is set (the Runtime path); empty uses ~/.kube/cwe-<cluster>.yaml
CWE_EKS_KUBECONFIG=
# Heavy build/run Pods (WorkloadProfile). `deploy.sh --stage images --workload` writes this value.
CWE_WORKLOAD_IMAGE=
# Sticky sessions on AgentCore Runtime: DynamoDB table and KMS key from infra/terraform/runtime.
# Empty keeps the registry in the recordings store (one Runtime process at a time, no cross-process lease). On S3 that store must be sealed with the KMS key below.
CWE_SESSION_TABLE=
CWE_REGISTRY_KMS_KEY_ID=          # required when the registry lives in an S3 recordings store; the runtime root outputs it
CWE_SESSION_REGISTRY_TTL_SECONDS=86400
# Emulator image. `deploy.sh --stage images --mirror-emulator` copies the public API 30 image into ECR under an
# immutable tag and writes this value; empty falls back to the public Google image with a mutable tag.
CWE_ANDROID_EMULATOR_IMAGE=
# Legacy EC2 backend (only used with CWE_ANDROID_BACKEND=ec2)
CWE_ANDROID_SUBNET_ID=
CWE_ANDROID_SECURITY_GROUP_ID=
CWE_ANDROID_INSTANCE_PROFILE=cwe-android-instance-profile
CWE_ANDROID_DEVICE_AGENT_IMAGE=
CWE_ANDROID_INSTANCE_TYPE=c8i.xlarge
# ssm (default) | private | public
CWE_ANDROID_ACCESS=ssm
# Instance profile used only by scripts/build_emulator_image.sh (the only role with ECR push)
CWE_ANDROID_BUILD_INSTANCE_PROFILE=cwe-emulator-image-build-profile
# Shared key for the REST API. Empty means unauthenticated, and `cwe serve` then binds 127.0.0.1 only.
CWE_API_KEY=
# Default budget applied to any agent run started without an explicit RunBudget
CWE_DEFAULT_MAX_EXECUTIONS=60
CWE_DEFAULT_MAX_SECONDS=1200
CWE_DEFAULT_MAX_COST_USD=5.0
CWE_DEFAULT_MAX_TURNS=40
