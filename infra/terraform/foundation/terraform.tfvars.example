region                 = "us-east-1"
project_name           = "cwe-eks"
vpc_id                 = "vpc-REPLACE"
subnet_ids     = ["subnet-REPLACE-A", "subnet-REPLACE-B"]
# Set an EKS-supported version explicitly before planning.
cluster_version        = "REPLACE"
cluster_admin_role_arn = "arn:aws:iam::ACCOUNT:role/EksAdministrator"
operator_role_arns     = ["arn:aws:iam::ACCOUNT:role/CweOperator"]
# Default is private-only. Use a VPN or an in-VPC Terraform runner.
endpoint_public_access = false
# For local access without VPN:
# endpoint_public_access       = true
# endpoint_public_access_cidrs = ["203.0.113.10/32"] # replace with your fixed egress
# Sandbox and operator S3 access is confined to this prefix of the recordings bucket.
recordings_prefix     = "cwe"
android_instance_type = "m8i.2xlarge"
android_desired_size  = 1
android_max_size      = 4
# Network policy enforcement. Create the cluster in standard mode; after the platform stage exists, set "strict"
# and re-apply so every new Pod starts default-deny (see GUIDE.md 3.3).
network_policy_enforcing_mode = "standard"
# Build/run workload nodes (no KVM needed). Size memory for your largest build.
build_instance_type = "r7i.2xlarge"
build_volume_size   = 300
build_desired_size  = 1
build_max_size      = 4
